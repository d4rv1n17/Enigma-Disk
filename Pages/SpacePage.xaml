<UserControl x:Class="EnigmaDisk.Pages.SpacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EnigmaDisk.Controls">
    <Grid Margin="28,26,28,32" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource s.tm.title}" Style="{StaticResource H1}" />
                <TextBlock Text="{DynamicResource s.tm.sub}" Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"
                           TextWrapping="Wrap" TextTrimming="None" MaxWidth="820" HorizontalAlignment="Left" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Top" Margin="0,4,0,0" Click="Hint_Click" Style="{StaticResource IconBtn}"
                    ToolTip="{DynamicResource s.tm.hintText}">
                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" />
            </Button>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="0,20,0,0">
            <StackPanel Margin="0,0,16,8">
                <TextBlock Text="{DynamicResource s.gr.lDrive}" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource SegHost}">
                    <StackPanel x:Name="DriveSeg" Orientation="Horizontal" />
                </Border>
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
                <TextBlock Text="{DynamicResource s.tm.legend}" Style="{StaticResource Caption}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="14" Height="14" CornerRadius="4" Background="#262626" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource s.fl.folders}" Style="{StaticResource Muted}" Margin="7,0,18,0" VerticalAlignment="Center" />
                    <Border Width="14" Height="14" CornerRadius="4" Background="#4A3F1D" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource s.fl.bigFiles}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </WrapPanel>

        <!-- Путь + сумма + кнопки -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="8" Margin="0,16,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="UpButton" Click="Up_Click" Margin="0,0,10,0" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74A;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource s.tm.up}" />
                    </StackPanel>
                </Button>
                <ItemsControl x:Name="Crumbs" Grid.Column="1" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Link}" Content="{Binding Name}" Tag="{Binding Path}" Click="Crumb_Click"
                                        FontSize="13" Padding="6,4" />
                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource DimBrush}" Margin="2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TotalText" Style="{StaticResource Muted}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Button Click="Explorer_Click" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource s.tm.open}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Карта -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="10" Margin="0,0,0,0">
            <Grid>
                <c:TreemapPanel x:Name="Map" />
                <Border x:Name="MapEmpty" Background="{StaticResource PanelBrush}" Visibility="Collapsed">
                    <TextBlock x:Name="TotalEmptyText" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
