<UserControl x:Class="EnigmaDisk.Pages.GrowthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EnigmaDisk.Controls">
    <Grid Margin="40,30,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource s.gr.title}" Style="{StaticResource H1}" />
            <TextBlock Text="{DynamicResource s.gr.sub}" Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"
                       TextWrapping="Wrap" TextTrimming="None" MaxWidth="760" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Фильтры с подписями -->
        <WrapPanel Grid.Row="1" Margin="0,22,0,0">
            <StackPanel Margin="0,0,16,8">
                <TextBlock Text="{DynamicResource s.gr.lDrive}" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource SegHost}">
                    <StackPanel x:Name="DriveSeg" Orientation="Horizontal" />
                </Border>
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
                <TextBlock Text="{DynamicResource s.gr.lPeriod}" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource SegHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Seg}" GroupName="period" Content="{DynamicResource s.gr.day}" Tag="1" Checked="Period_Checked" />
                        <RadioButton Style="{StaticResource Seg}" GroupName="period" Content="{DynamicResource s.gr.week}" Tag="7" IsChecked="True" Checked="Period_Checked" />
                        <RadioButton Style="{StaticResource Seg}" GroupName="period" Content="{DynamicResource s.gr.month}" Tag="30" Checked="Period_Checked" />
                        <RadioButton Style="{StaticResource Seg}" GroupName="period" Content="{DynamicResource s.gr.all}" Tag="100000" Checked="Period_Checked" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
                <TextBlock Text="{DynamicResource s.gr.lShow}" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource SegHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ModeGrew" Style="{StaticResource Seg}" GroupName="mode" Content="{DynamicResource s.gr.grew}" IsChecked="True" Checked="Mode_Checked" />
                        <RadioButton x:Name="ModeShrank" Style="{StaticResource Seg}" GroupName="mode" Content="{DynamicResource s.gr.shrank}" Checked="Mode_Checked" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </WrapPanel>

        <!-- Итог -->
        <Border x:Name="Summary" Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SumDelta" Style="{StaticResource Big}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SumTitle" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="SumSub" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="ClickHint" Grid.Row="3" Text="{DynamicResource s.gr.clickHint}" Style="{StaticResource Muted}"
                   Margin="4,0,0,8" Visibility="Collapsed" />

        <!-- Пустое состояние -->

        <TextBlock x:Name="Loading" Grid.Row="4" Text="{DynamicResource s.gr.loading}" Style="{StaticResource Muted}" FontSize="13"
                   Margin="4,10,0,0" Visibility="Collapsed" />

        <!-- Список -->
        <ListBox x:Name="List" Grid.Row="4" Background="Transparent" BorderThickness="0" Margin="-14,0,-14,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                 Focusable="False">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource RowButton}" Tag="{Binding Path}" Click="Row_Click" Margin="0,0,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Margin="0,0,14,0">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding Parent}" Style="{StaticResource Muted}" Margin="0,2,0,0" ToolTip="{Binding Path}" />
                                <WrapPanel Margin="0,7,0,0">
                                    <Border Style="{StaticResource Chip}" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding FromTo}" Style="{StaticResource Muted}" FontSize="11" />
                                    </Border>
                                    <Border Style="{StaticResource AccentChip}" Margin="0,0,6,0" Visibility="{Binding Cleanable, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{DynamicResource s.gr.cleanable}" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                                    </Border>
                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                                </WrapPanel>
                            </StackPanel>
                            <c:Bar Grid.Column="2" Fraction="{Binding Fraction}" Fill="{Binding DataContext.BarBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Grid.Column="3" Text="{Binding DeltaText}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{Binding DataContext.DeltaBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <Button Grid.Column="4" Style="{StaticResource Link}" Margin="12,0,0,0"
                                    VerticalAlignment="Center" Tag="{Binding Path}" Click="Open_Click"
                                    ToolTip="{DynamicResource s.gr.openTip}">
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="14" />
                            </Button>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Пустое состояние поверх списка, чтобы кнопка в нём нажималась -->
        <Border x:Name="Empty" Grid.Row="4" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="Collapsed" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconTile}" Width="44" Height="44">
                    <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource H2}" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Body}" Margin="0,6,0,0" MaxWidth="600" HorizontalAlignment="Left" />
                </StackPanel>
                <Button x:Name="EmptyScan" Grid.Column="2" Style="{StaticResource Primary}" Content="{DynamicResource s.common.makeSnapshot}"
                        VerticalAlignment="Center" Margin="20,0,0,0" Click="EmptyScan_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
