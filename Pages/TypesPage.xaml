<UserControl x:Class="EnigmaDisk.Pages.TypesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EnigmaDisk.Controls">
    <Grid Margin="28,26,28,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource s.ty.title}" Style="{StaticResource H1}" />
            <TextBlock Text="{DynamicResource s.ty.sub}" Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"
                       TextWrapping="Wrap" TextTrimming="None" MaxWidth="820" HorizontalAlignment="Left" />
            <WrapPanel Margin="0,20,0,0">
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="{DynamicResource s.gr.lDrive}" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource SegHost}">
                        <StackPanel x:Name="DriveSeg" Orientation="Horizontal" />
                    </Border>
                </StackPanel>
            </WrapPanel>
        </StackPanel>

        <!-- Пончик + итог -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,16" Padding="28,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:TypeDonut x:Name="Donut" Width="250" Height="250" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="36,0,0,0" VerticalAlignment="Center" x:Name="Legend" />
            </Grid>
        </Border>

        <!-- Расширения выбранной категории -->
        <Grid Grid.Row="2" Margin="0,2,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
                <TextBlock x:Name="ExtTitle" Style="{StaticResource H2}" FontSize="14" />
                <TextBlock x:Name="ExtSub" Style="{StaticResource Muted}" Margin="0,3,0,0" />
            </StackPanel>
            <ListBox x:Name="List" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" Focusable="False">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource RowButton}" Margin="0,0,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Chip}" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="9,4">
                                <TextBlock Text="{Binding E}" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding CategoryName}" Style="{StaticResource Muted}" Margin="14,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <c:Bar Grid.Column="2" Fraction="{Binding Fraction}" Fill="{Binding DataContext.BarBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Grid.Column="3" Text="{Binding CountText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding SizeText}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
    </Grid>
</UserControl>
