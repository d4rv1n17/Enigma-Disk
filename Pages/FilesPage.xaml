<UserControl x:Class="EnigmaDisk.Pages.FilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EnigmaDisk.Controls">
    <Grid Margin="40,30,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource s.fl.title}" Style="{StaticResource H1}" />
            <TextBlock Text="{DynamicResource s.fl.sub}" Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None" />
            <TextBlock x:Name="Subtitle" Style="{StaticResource Muted}" Foreground="{StaticResource DimBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,20,0,0">
            <StackPanel Margin="0,0,16,8">
                <TextBlock Text="{DynamicResource s.gr.lDrive}" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource SegHost}">
                    <StackPanel x:Name="DriveSeg" Orientation="Horizontal" />
                </Border>
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
                <TextBlock Text="{DynamicResource s.gr.lShow}" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource SegHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabFolders" Style="{StaticResource Seg}" GroupName="ftab" Content="{DynamicResource s.fl.folders}" IsChecked="True" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabFiles" Style="{StaticResource Seg}" GroupName="ftab" Content="{DynamicResource s.fl.bigFiles}" Checked="Tab_Checked" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </WrapPanel>

        <!-- Хлебные крошки -->
        <Border x:Name="CrumbBar" Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="8" Margin="0,8,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="UpButton" Click="Up_Click" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74A;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource s.fl.up}" />
                    </StackPanel>
                </Button>
                <ItemsControl x:Name="Crumbs" Grid.Column="1" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Link}" Content="{Binding Name}" Tag="{Binding Path}" Click="Crumb_Click"
                                        FontSize="13" Padding="6,4" />
                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource DimBrush}" Margin="2,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Column="2" Click="Explorer_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource s.common.openExplorer}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Заголовки колонок -->
        <Grid x:Name="ColHeader" Grid.Row="3" Margin="0,4,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="{DynamicResource s.fl.colName}" Style="{StaticResource Caption}" />
            <TextBlock x:Name="ColShare" Grid.Column="2" Text="{DynamicResource s.fl.colShare}" Style="{StaticResource Caption}" />
            <TextBlock x:Name="ColWeek" Grid.Column="3" Text="{DynamicResource s.fl.colWeek}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,0,0,6" />
            <TextBlock Grid.Column="4" Text="{DynamicResource s.fl.colSize}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,0,0,6" />
        </Grid>


        <ListBox x:Name="List" Grid.Row="4" Background="Transparent" BorderThickness="0" Margin="-14,0,-14,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" Focusable="False">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource RowButton}" Tag="{Binding}" Click="Row_Click" Margin="0,0,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" Foreground="{Binding IconBrush}" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" ToolTip="{Binding Path}" />
                                <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                <c:Bar Fraction="{Binding Fraction}" Fill="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding PercentText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding DeltaText}" Style="{StaticResource AccentText}" FontSize="12"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{DynamicResource s.fl.weekTip}" />
                            <TextBlock Grid.Column="4" Text="{Binding SizeText}" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Пустое состояние поверх списка, чтобы кнопка в нём нажималась -->
        <Border x:Name="Empty" Grid.Row="4" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconTile}" Width="44" Height="44">
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource H2}" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Body}" Margin="0,6,0,0" />
                </StackPanel>
                <Button x:Name="EmptyScan" Grid.Column="2" Style="{StaticResource Primary}" Content="{DynamicResource s.common.makeSnapshot}"
                        VerticalAlignment="Center" Margin="20,0,0,0" Click="EmptyScan_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
