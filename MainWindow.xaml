<Window x:Class="EnigmaDisk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enigma Disk" Width="1240" Height="820" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        Icon="Assets/icon.png">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Боковое меню -->
        <Border Background="#121212">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="26,28,0,28">
                    <Image Source="Assets/icon.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Enigma Disk" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource s.app.tagline}" Style="{StaticResource Muted}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavOverview" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="{DynamicResource s.nav.overview}" GroupName="nav" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavGrowth" Style="{StaticResource Nav}" Tag="&#xE9D2;" Content="{DynamicResource s.nav.growth}" GroupName="nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSpace" Style="{StaticResource Nav}" Tag="&#xE71D;" Content="{DynamicResource s.nav.space}" GroupName="nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavTypes" Style="{StaticResource Nav}" Tag="&#xE8B5;" Content="{DynamicResource s.nav.types}" GroupName="nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavFiles" Style="{StaticResource Nav}" Tag="&#xE8B7;" Content="{DynamicResource s.nav.files}" GroupName="nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavDuplicates" Style="{StaticResource Nav}" Tag="&#xE8CB;" Content="{DynamicResource s.nav.duplicates}" GroupName="nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavClean" Style="{StaticResource Nav}" Tag="&#xEA99;" Content="{DynamicResource s.nav.clean}" GroupName="nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavExclude" Style="{StaticResource Nav}" Tag="&#xF19D;" Content="{DynamicResource s.nav.exclude}" GroupName="nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Content="{DynamicResource s.nav.settings}" GroupName="nav" Checked="Nav_Checked" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="26,0,20,22">
                    <Border Style="{StaticResource SegHost}" Background="{StaticResource PanelBrush}" Margin="-2,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LangRu" Style="{StaticResource Seg}" Content="RU" GroupName="sideLang" Checked="Lang_Checked" />
                            <RadioButton x:Name="LangEn" Style="{StaticResource Seg}" Content="EN" GroupName="sideLang" Checked="Lang_Checked" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SideStatus" Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" />
                    <TextBlock Text="{DynamicResource s.app.version}" Style="{StaticResource Muted}" Foreground="{StaticResource DimBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Баннер уведомлений -->
            <Border x:Name="NotifBar" Visibility="Collapsed" Background="{StaticResource AccentSoftBrush}" Margin="40,18,40,0"
                    CornerRadius="12" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NotifIcon" Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock x:Name="NotifTitle" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock x:Name="NotifBody" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="NotifOpen" Content="{DynamicResource s.common.open}" Margin="14,0,8,0" VerticalAlignment="Center" Padding="12,6" Click="NotifOpen_Click" />
                    <Button x:Name="NotifClose" Content="&#xE711;" Style="{StaticResource IconBtn}" Grid.Column="3" VerticalAlignment="Center" Click="NotifClose_Click" />
                </Grid>
            </Border>

            <!-- Полоса сканирования -->
            <Border x:Name="ScanBar" Visibility="Collapsed" Background="{StaticResource PanelBrush}" Margin="40,18,40,0"
                    CornerRadius="14" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="Pulse" Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ScanTitle" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock x:Name="ScanStats" Margin="12,0,0,0" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock x:Name="ScanPath" Style="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        <Grid Margin="0,9,0,0">
                            <Border Height="3" CornerRadius="2" Background="{StaticResource LineBrush}" />
                            <Border x:Name="ScanProgress" Height="3" CornerRadius="2" Background="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <TextBlock Text="{DynamicResource s.scan.hint}" Style="{StaticResource Muted}" Foreground="{StaticResource DimBrush}" Margin="0,6,0,0" FontSize="11" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{DynamicResource s.common.cancel}" Margin="20,0,0,0" VerticalAlignment="Center" Click="CancelScan_Click" />
                </Grid>
            </Border>

            <ContentControl x:Name="Host" Grid.Row="1" Focusable="False" />
        </Grid>
        <!-- Короткое анимированное интро; отключается в настройках. -->
        <Grid x:Name="IntroOverlay" Panel.ZIndex="20" Visibility="Collapsed" Background="#0F0F0F" IsHitTestVisible="True">
            <Grid Opacity="0" x:Name="IntroContent" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="104" Height="104" HorizontalAlignment="Center" Margin="0,0,0,28">
                        <Ellipse Stroke="{StaticResource LineBrush}" StrokeThickness="2" />
                        <Ellipse x:Name="IntroRing" Margin="8" Stroke="{StaticResource AccentBrush}" StrokeThickness="3"
                                 StrokeDashArray="0.18 0.82" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform x:Name="IntroRotate" Angle="0" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Image Source="Assets/icon.png" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <TextBlock Text="Enigma Disk" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource s.app.tagline}" Style="{StaticResource Muted}" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock x:Name="IntroPreviewHint" Text="{DynamicResource s.intro.previewHint}" Style="{StaticResource Muted}"
                               HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed" />
                    <Border Width="110" Height="3" Background="{StaticResource LineBrush}" CornerRadius="2" Margin="0,30,0,0">
                        <Border x:Name="IntroProgress" Width="0" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" CornerRadius="2" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
