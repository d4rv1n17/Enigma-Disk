<UserControl x:Class="EnigmaDisk.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="28,26,28,32" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource s.st.title}" Style="{StaticResource H1}" />
            <TextBlock Text="{DynamicResource s.st.sub}" Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" />

            <!-- Язык -->
            <Border Style="{StaticResource Card}" Margin="0,24,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Margin="0,0,16,0">
                        <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource s.st.lang}" Style="{StaticResource H2}" />
                        <TextBlock Text="{DynamicResource s.st.langSub}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource SegHost}" Background="{StaticResource Panel2Brush}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LangRu" Style="{StaticResource Seg}" Content="Русский" GroupName="stLang" Checked="Lang_Checked" />
                            <RadioButton x:Name="LangEn" Style="{StaticResource Seg}" Content="English" GroupName="stLang" Checked="Lang_Checked" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Запуск приложения -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Margin="0,0,16,0">
                        <TextBlock Text="&#xE7C1;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource s.st.startup}" Style="{StaticResource H2}" />
                        <TextBlock Text="{DynamicResource s.st.introSub}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <CheckBox x:Name="IntroCheck" Content="{DynamicResource s.st.introCheck}" Click="Intro_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Автоснимки -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Margin="0,0,16,0">
                        <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource s.st.auto}" Style="{StaticResource H2}" />
                        <TextBlock Text="{DynamicResource s.st.autoSub}" Style="{StaticResource Body}" Margin="0,6,0,16" FontSize="12" />
                        <CheckBox x:Name="AutoCheck" Content="{DynamicResource s.st.autoCheck}" Click="Auto_Click" />
                        <StackPanel Orientation="Horizontal" Margin="28,14,0,0">
                            <TextBlock Text="{DynamicResource s.st.time}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Width="140" />
                            <TextBox x:Name="HourBox" Width="56" TextAlignment="Center" MaxLength="2" LostFocus="Hour_LostFocus" TextChanged="Box_TextChanged" />
                            <TextBlock Text=":00" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="28,14,0,0">
                            <TextBlock Text="{DynamicResource s.st.drives}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Top" Width="140" Margin="0,1,0,0" />
                            <WrapPanel x:Name="DriveChecks" />
                        </StackPanel>
                        <TextBlock x:Name="AutoStatus" Style="{StaticResource Muted}" Margin="28,14,0,0" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Сравнение -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Margin="0,0,16,0">
                        <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource s.st.compare}" Style="{StaticResource H2}" />
                        <TextBlock Text="{DynamicResource s.st.compareSub}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Text="{DynamicResource s.st.minLabel}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Width="200" />
                            <TextBox x:Name="MinBox" Width="70" TextAlignment="Center" MaxLength="5" LostFocus="Min_LostFocus" TextChanged="Box_TextChanged" />
                            <TextBlock Text="{DynamicResource s.st.mb}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="DiskSizeCheck" Content="{DynamicResource s.st.diskSize}" Margin="0,16,0,0" Click="DiskSize_Click" />
                        <TextBlock Text="{DynamicResource s.st.diskSizeSub}" Style="{StaticResource Muted}" Margin="28,5,0,0" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Хранение -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Margin="0,0,16,0">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource s.st.store}" Style="{StaticResource H2}" />
                        <TextBlock Text="{DynamicResource s.st.storeSub}" Style="{StaticResource Body}" Margin="0,6,0,16" FontSize="12" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource s.st.keepLabel}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Width="200" />
                            <TextBox x:Name="KeepBox" Width="70" TextAlignment="Center" MaxLength="4" LostFocus="Keep_LostFocus" TextChanged="Box_TextChanged" />
                            <TextBlock Text="{DynamicResource s.st.days}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="StoreInfo" Style="{StaticResource Muted}" Margin="0,16,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="{DynamicResource s.st.openData}" Click="OpenData_Click" Margin="0,0,10,0" />
                            <Button Style="{StaticResource Danger}" Content="{DynamicResource s.st.deleteAll}" Click="DeleteAll_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Уведомления -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Margin="0,0,16,0">
                        <TextBlock Text="&#xEA8F;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource s.nt.settings}" Style="{StaticResource H2}" />
                        <TextBlock Text="{DynamicResource s.nt.settingsSub}" Style="{StaticResource Body}" Margin="0,6,0,16" FontSize="12" />
                        <CheckBox x:Name="NotifNearFullCheck" Content="{DynamicResource s.nt.nearFullCheck}" Click="Notif_Click" />
                        <StackPanel Orientation="Horizontal" Margin="28,12,0,0">
                            <TextBlock Text="{DynamicResource s.nt.nearFullAt}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="NearFullBox" Width="72" TextAlignment="Center" MaxLength="3" TextChanged="NearFull_TextChanged" />
                            <TextBlock Text="{DynamicResource s.nt.percent}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="NotifGrowthCheck" Content="{DynamicResource s.nt.growthCheck}" Margin="0,12,0,0" Click="Notif_Click" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="{DynamicResource s.nt.test}" Click="NotifTest_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Экспорт отчёта -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Margin="0,0,16,0">
                        <TextBlock Text="&#xE8C5;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource s.rp.title}" Style="{StaticResource H2}" />
                        <TextBlock Text="{DynamicResource s.rp.sub}" Style="{StaticResource Body}" Margin="0,6,0,14" FontSize="12" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ReportBtn" Style="{StaticResource Primary}" Click="Report_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C5;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{DynamicResource s.rp.export}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ReportOpen" Content="{DynamicResource s.rp.open}" Margin="10,0,0,0" Visibility="Collapsed" Click="ReportOpen_Click" />
                            <TextBlock x:Name="ReportStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Обновления -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Margin="0,0,16,0">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource s.upd.title0}" Style="{StaticResource H2}" />
                        <TextBlock Text="{DynamicResource s.upd.sub}" Style="{StaticResource Body}" Margin="0,6,0,14" FontSize="12" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CheckUpdatesBtn" Style="{StaticResource Primary}" Click="CheckUpdates_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{DynamicResource s.about.checkUpdates}" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="CheckUpdatesBox" Content="{DynamicResource s.upd.atStartup}" Margin="0,14,0,0" Click="CheckUpdatesSetting_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- О программе -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="/Assets/icon.png" Width="36" Height="36" Margin="0,0,16,0" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource s.st.about}" Style="{StaticResource H2}" />
                        <TextBlock Text="{DynamicResource s.about.subtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0" FontSize="12" />
                        <TextBlock Text="{DynamicResource s.st.aboutText}" Style="{StaticResource Body}" Margin="0,6,0,0" FontSize="12" />
                        <TextBlock Text="{DynamicResource s.about.author}" Style="{StaticResource Muted}" Margin="0,10,0,0" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button Content="{DynamicResource s.st.howTo}" Click="HowTo_Click" ToolTip="{DynamicResource s.wc.intro}" />
                        <Button Content="{DynamicResource s.about.openUrl}" Margin="0,8,0,0" Click="OpenUrl_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
