<UserControl x:Class="EnigmaDisk.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EnigmaDisk.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="40,30,40,40">
            <!-- Заголовок -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource s.ov.title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{DynamicResource s.ov.sub}" Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None" />
                    <TextBlock x:Name="Subtitle" Style="{StaticResource Muted}" Foreground="{StaticResource DimBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Button x:Name="MainScan" Grid.Column="1" Style="{StaticResource Primary}" Padding="18,10" VerticalAlignment="Top"
                        Margin="20,4,0,0" Click="MainScan_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock x:Name="MainScanText" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Как это работает -->
            <StackPanel x:Name="HowItWorks" Margin="0,26,0,0">
                <TextBlock Text="{DynamicResource s.ov.howTitle}" Style="{StaticResource H2}" Margin="0,0,0,12" />
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <Border Style="{StaticResource IconTile}" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="1" FontWeight="Bold" FontSize="15" Foreground="#111111" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{DynamicResource s.ov.step1t}" Style="{StaticResource H2}" Margin="0,14,0,0" />
                            <TextBlock Text="{DynamicResource s.ov.step1d}" Style="{StaticResource Body}" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                        <StackPanel>
                            <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left">
                                <TextBlock Text="2" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{DynamicResource s.ov.step2t}" Style="{StaticResource H2}" Margin="0,14,0,0" />
                            <TextBlock Text="{DynamicResource s.ov.step2d}" Style="{StaticResource Body}" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left">
                                <TextBlock Text="3" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{DynamicResource s.ov.step3t}" Style="{StaticResource H2}" Margin="0,14,0,0" />
                            <TextBlock Text="{DynamicResource s.ov.step3d}" Style="{StaticResource Body}" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>

            <!-- Совет про автоснимки -->
            <Border x:Name="AutoTip" Style="{StaticResource Tip}" Margin="0,16,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Text="{DynamicResource s.ov.tipAuto}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" />
                    <Button Grid.Column="2" Content="{DynamicResource s.ov.tipAutoBtn}" Margin="16,0,0,0" Click="AutoTip_Click" />
                </Grid>
            </Border>

            <!-- Диски -->
            <TextBlock Text="{DynamicResource s.ov.drives}" Style="{StaticResource H2}" Margin="0,26,0,12" />
            <ItemsControl x:Name="Drives">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="340" Margin="0,0,16,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <c:Ring Width="92" Height="92" Fraction="{Binding UsedFraction}" Fill="{Binding BarBrush}" Caption="{Binding UsedCaption}" />
                                    <StackPanel Grid.Column="1" Margin="20,4,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Letter}" Style="{StaticResource H2}" FontSize="22" />
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" Margin="10,0,0,3"
                                                       VerticalAlignment="Bottom" MaxWidth="130" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding FreeText}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding TotalText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18,0,14" />
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WeekText}" Style="{StaticResource AccentText}" FontSize="13"
                                                   Visibility="{Binding WeekVisibility}" />
                                        <TextBlock Text="{Binding LastScanText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Content="{DynamicResource s.common.scan}" HorizontalAlignment="Right" Tag="{Binding Root}"
                                            IsEnabled="{Binding CanScan}" Click="Scan_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- График -->
            <Border x:Name="ChartCard" Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="ChartTitle" Style="{StaticResource H2}" />
                            <TextBlock x:Name="ChartSub" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource SegHost}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="{StaticResource Panel2Brush}">
                            <StackPanel x:Name="ChartDrives" Orientation="Horizontal" />
                        </Border>
                    </Grid>
                    <c:LineChart x:Name="Chart" Height="210" Margin="0,18,0,0" />
                </StackPanel>
            </Border>

            <!-- Главное за неделю -->
            <Border x:Name="TopCard" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="TopTitle" Style="{StaticResource H2}" />
                            <TextBlock x:Name="TopSub" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource Link}" Content="{DynamicResource s.ov.allChanges}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Click="AllChanges_Click" />
                    </Grid>
                    <ItemsControl x:Name="TopList" Margin="-14,12,-14,-6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButton}" Tag="{Binding Path}" Click="Row_Click"
                                        ToolTip="{Binding Path}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0">
                                                <Run Text="{Binding HintDot, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                                                <Run Text="{Binding Parent, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <c:Bar Grid.Column="1" Fraction="{Binding Fraction}" VerticalAlignment="Center" Margin="12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding DeltaText}" Style="{StaticResource AccentText}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TopEmpty" Style="{StaticResource Body}" Margin="0,14,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
