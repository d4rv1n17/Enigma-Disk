<Window x:Class="EnigmaDiskSetup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enigma Disk" Width="620" Height="500" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        Icon="Assets/icon.png">
    <Grid Margin="36,28,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid>
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/icon.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Enigma Disk" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock x:Name="Header" Style="{StaticResource Muted}" />
                </StackPanel>
            </StackPanel>
            <Border Style="{StaticResource SegHost}" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LangRu" Style="{StaticResource Seg}" Content="RU" GroupName="lang" Checked="Lang_Checked" />
                    <RadioButton x:Name="LangEn" Style="{StaticResource Seg}" Content="EN" GroupName="lang" Checked="Lang_Checked" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Шаг 1: параметры -->
        <StackPanel x:Name="PageOptions" Grid.Row="1" Margin="0,30,0,0">
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}" FontSize="26" TextWrapping="Wrap" TextTrimming="None" />
            <TextBlock x:Name="Pitch" Style="{StaticResource Body}" FontSize="13" Margin="0,8,0,0" />

            <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="18,16">
                <StackPanel>
                    <TextBlock x:Name="FolderLabel" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource Panel2Brush}" CornerRadius="7" Padding="12,8">
                            <TextBlock x:Name="FolderText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Border>
                        <Button x:Name="ChangeButton" Grid.Column="1" Margin="10,0,0,0" Click="Change_Click" />
                    </Grid>
                    <CheckBox x:Name="DesktopCheck" Margin="0,18,0,0" IsChecked="True" />
                    <CheckBox x:Name="LaunchCheck" Margin="0,12,0,0" IsChecked="True" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="Note" Style="{StaticResource Muted}" Margin="2,14,0,0" TextWrapping="Wrap" TextTrimming="None" />
        </StackPanel>

        <!-- Шаг 2: установка -->
        <StackPanel x:Name="PageProgress" Grid.Row="1" Margin="0,60,0,0" Visibility="Collapsed">
            <TextBlock x:Name="WorkingTitle" Style="{StaticResource H1}" FontSize="26" />
            <TextBlock x:Name="StepText" Style="{StaticResource Muted}" FontSize="13" Margin="0,10,0,0" />
            <Grid Margin="0,24,0,0">
                <Border Height="6" CornerRadius="3" Background="{StaticResource LineBrush}" />
                <Border x:Name="ProgressFill" Height="6" CornerRadius="3" Background="{StaticResource AccentBrush}"
                        HorizontalAlignment="Left" Width="0" />
            </Grid>
            <TextBlock x:Name="PercentText" Style="{StaticResource Muted}" Margin="0,10,0,0" HorizontalAlignment="Right" />
        </StackPanel>

        <!-- Шаг 3: готово -->
        <StackPanel x:Name="PageDone" Grid.Row="1" Margin="0,50,0,0" Visibility="Collapsed">
            <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left">
                <Path Data="M 16,29 L 24,37 L 40,20" Stroke="#111111" StrokeThickness="4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Border>
            <TextBlock x:Name="DoneTitle" Style="{StaticResource H1}" FontSize="26" Margin="0,20,0,0" />
            <TextBlock x:Name="DoneText" Style="{StaticResource Body}" FontSize="13" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Click="Cancel_Click" Margin="0,0,10,0" />
            <Button x:Name="MainButton" Style="{StaticResource Primary}" Padding="26,10" Click="Main_Click" />
        </StackPanel>
    </Grid>
</Window>
