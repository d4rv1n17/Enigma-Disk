<UserControl x:Class="EnigmaDisk.Pages.DuplicatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EnigmaDisk.Controls">
    <Grid Margin="28,26,28,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource s.du.title}" Style="{StaticResource H1}" />
            <TextBlock Text="{DynamicResource s.du.sub}" Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"
                       TextWrapping="Wrap" TextTrimming="None" MaxWidth="760" HorizontalAlignment="Left" />
            <WrapPanel Margin="0,20,0,0">
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="{DynamicResource s.gr.lDrive}" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource SegHost}">
                        <StackPanel x:Name="DriveSeg" Orientation="Horizontal" />
                    </Border>
                </StackPanel>
                <StackPanel Margin="0,0,16,8" VerticalAlignment="Bottom">
                    <Button x:Name="FindBtn" Style="{StaticResource Primary}" Padding="18,10" Click="Find_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock x:Name="FindBtnText" Text="{DynamicResource s.du.find}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </WrapPanel>
        </StackPanel>

        <!-- Итог / прогресс -->
        <StackPanel Grid.Row="1" Margin="0,16,0,10">
            <Border x:Name="Summary" Style="{StaticResource Card}" Padding="20,14" Visibility="Collapsed">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="SumText" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="SumSub" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button x:Name="DeleteBtn" Style="{StaticResource Danger}" Content="{DynamicResource s.du.delete}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="Delete_Click" />
                </Grid>
            </Border>
            <Border x:Name="Progress" Style="{StaticResource Card}" Padding="20,14" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ProgTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="ProgPath" Style="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    <Grid Margin="0,10,0,0">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource LineBrush}" />
                        <Border x:Name="ProgBar" Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Width="0" />
                    </Grid>
                    <Button Content="{DynamicResource s.du.stop}" Margin="0,12,0,0" HorizontalAlignment="Left" Click="Stop_Click" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Список групп -->
        <ListBox x:Name="List" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="-14,0,-14,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" Focusable="False">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="20,16">
                        <StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding CopiesText}" Style="{StaticResource Muted}" />
                                    <TextBlock Text="  ·  " Foreground="{StaticResource DimBrush}" />
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Muted}" />
                                    <TextBlock Text="  ·  " Foreground="{StaticResource DimBrush}" />
                                    <TextBlock Text="{Binding WasteText}" Style="{StaticResource AccentText}" />
                                </StackPanel>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Items}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowButton}" Margin="0,0,0,2" Padding="10,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="28" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Visibility="{Binding CanSelect, Converter={StaticResource BoolVis}}" />
                                                </Grid>
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                        <Border Style="{StaticResource AccentChip}" Margin="8,0,0,0"
                                                                Visibility="{Binding IsOriginal, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="{DynamicResource s.du.keepOriginal}" Foreground="{StaticResource AccentBrush}" FontSize="10" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Folder}" Style="{StaticResource Muted}" FontSize="11" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource IconBtn}" Tag="{Binding Path}" Click="Show_Click" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="13" />
                                                </Button>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
