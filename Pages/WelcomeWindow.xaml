<Window x:Class="EnigmaDisk.Pages.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enigma Disk" Width="640" SizeToContent="Height" MinWidth="560" MaxWidth="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="36,32,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка: иконка + приветствие -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Image Source="/Assets/icon.png" Width="44" Height="44" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource s.wc.hi}" Style="{StaticResource H1}" FontSize="24" />
                <TextBlock Text="{DynamicResource s.app.tagline}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{DynamicResource s.wc.intro}" Style="{StaticResource Body}" Margin="0,10,0,4" />

        <!-- Три шага -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,18,0,0">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16,16">
                <StackPanel>
                    <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource s.wc.q1t}" Style="{StaticResource H2}" FontSize="14" Margin="0,12,0,0" />
                    <TextBlock Text="{DynamicResource s.wc.q1d}" Style="{StaticResource Body}" FontSize="11" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="5,0,5,0" Padding="16,16">
                <StackPanel>
                    <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource s.wc.q2t}" Style="{StaticResource H2}" FontSize="14" Margin="0,12,0,0" />
                    <TextBlock Text="{DynamicResource s.wc.q2d}" Style="{StaticResource Body}" FontSize="11" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="10,0,0,0" Padding="16,16">
                <StackPanel>
                    <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xEA99;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource s.wc.q3t}" Style="{StaticResource H2}" FontSize="14" Margin="0,12,0,0" />
                    <TextBlock Text="{DynamicResource s.wc.q3d}" Style="{StaticResource Body}" FontSize="11" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Низ: действия -->
        <Grid Grid.Row="3" Margin="0,26,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="DontShow" Content="{DynamicResource s.wc.dontShow}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{DynamicResource s.wc.snapshot}" Margin="0,0,10,0" Click="Snapshot_Click" />
            <Button Grid.Column="2" Style="{StaticResource Primary}" Padding="20,9" Content="{DynamicResource s.wc.start}" Click="Start_Click" />
        </Grid>
    </Grid>
</Window>
