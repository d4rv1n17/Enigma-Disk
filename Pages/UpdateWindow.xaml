<Window x:Class="EnigmaDisk.Pages.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enigma Disk" Width="520" SizeToContent="Height" MinWidth="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Grid Margin="30,26,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource IconTile}" Width="44" Height="44" Background="{StaticResource AccentSoftBrush}">
                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
            </Border>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource H2}" FontSize="17" />
                <TextBlock x:Name="SubText" Style="{StaticResource Muted}" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0"
                      Visibility="{Binding HasNotes, Converter={StaticResource BoolVis}}">
            <TextBlock x:Name="NotesText" Style="{StaticResource Body}" FontSize="12" />
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,20,0,0" x:Name="ProgressRow" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center">
                <Border Height="4" CornerRadius="2" Background="{StaticResource LineBrush}" />
                <Border x:Name="ProgBar" Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}"
                        HorizontalAlignment="Left" Width="0" />
            </Grid>
            <TextBlock x:Name="ProgText" Grid.Column="1" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="PageBtn" Content="{DynamicResource s.upd.openPage}" Margin="0,0,10,0" Click="Page_Click" />
            <Button x:Name="LaterBtn" Content="{DynamicResource s.upd.later}" Margin="0,0,10,0" Click="Later_Click" />
            <Button x:Name="UpdateBtn" Style="{StaticResource Primary}" Padding="20,9" Click="Update_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="UpdateIcon" Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock x:Name="UpdateText" Text="{DynamicResource s.upd.update}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
